# ===== PRODUCTION CREDENTIALS =====
# Rotate every 30-90 days - See docs/key-rotation-schedule.md

# Database (Auto-rotation enabled via Neon)
DATABASE_URL=postgresql://...

# Payment Processing (Rotate: 30 days)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Communication (Rotate: 90 days)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=... # Sensitive - rotate every 90 days
TWILIO_PHONE_NUMBER=+44...

# AI Services (Rotate: 90 days)
OPENAI_API_KEY=sk-... # Sensitive - rotate every 90 days

# Call Integration (Rotate: 90 days)
JUSTCALL_API_KEY=... # Sensitive - rotate every 90 days

# Object Storage (Rotate: Annually)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Session Security (Rotate: Annually)
SESSION_SECRET=... # Must be cryptographically random (32+ chars)

# Email Service Configuration (for deposit protection reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@termflow.com

# Or use SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Base URL for email links
BASE_URL=https://termflow.com

# ===== SECURITY NOTES =====
# - Never commit real credentials to git
# - Use different credentials for dev/staging/production
# - Rotate compromised credentials immediately
# - See docs/key-rotation-schedule.md for rotation process
# - All webhook secrets required in production to prevent forgery
# - In development, webhooks will work without secrets but will log warnings
